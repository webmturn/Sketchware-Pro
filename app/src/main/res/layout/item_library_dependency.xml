<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="60dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <View android:id="@+id/dependency_indent" android:layout_width="0dp" android:layout_height="1dp" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/dependency_expand_icon"
        android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp"
        android:importantForAccessibility="no" app:srcCompat="@drawable/ic_mtrl_chevron_right_24"
        app:tint="?attr/colorOnSurfaceVariant" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:paddingVertical="8dp">
        <TextView android:id="@+id/dependency_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
            android:breakStrategy="balanced" android:maxLines="3" android:ellipsize="end"
            android:textColor="?attr/colorOnSurface" android:textSize="16sp" />
        <TextView android:id="@+id/dependency_metadata"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:includeFontPadding="false"
            android:breakStrategy="balanced" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
