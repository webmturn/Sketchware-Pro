<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_preference_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="@dimen/settings_row_padding_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="balanced"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/settings_text_line_spacing"
            android:textAppearance="@style/TextAppearance.SketchwarePro.SettingsTitle" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/settings_summary_gap"
            android:breakStrategy="balanced"
            android:includeFontPadding="false"
            android:lineSpacingExtra="@dimen/settings_text_line_spacing"
            android:textAppearance="@style/TextAppearance.SketchwarePro.SettingsSummary" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical" />
</LinearLayout>
